<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
</head>
<link rel="stylesheet" href="/style.css">
<body>
    <h1>All Chats</h1>
      <form method="get" action="/chats/new">
                <button class="main_page_btn">Create New Chat</button>
            </form>
            <br><br>
    <% for (chat of chats) { %>
        <div class="chat">
            <p>•From: <i><%=chat.from%></i></p>
            <div class="msg">
            <p>
                <%=chat.message%>
                <div class="msg_btn">
                    <form method="get" action="/chats/<%=chat._id%>/edit">
                    <button class="main_page_btn">Edit</button>
                </form>
                <form method="post" action="/chats/<%=chat._id%>?_method=DELETE">
                    <button class="main_page_btn">Delete</button>
                </form>
                </div>
            </p>
            </div>
            <p>•Recived By: <i>
                    <%=chat.to%>
                </i></p>
                <p><%=chat.created_at.toString().split(" ")[4]%></p>
                <p><%=chat.created_at.toString().split(" ").slice(0, 4).join("-")%></p>
            </div>
            <br><br>
            <%}%>
</body>
</html>